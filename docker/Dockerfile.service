# syntax=docker/dockerfile:1
# Generic, parameterized image for any AQROS backend service.
# Build with, e.g.:
#   docker build -f docker/Dockerfile.service \
#     --build-arg SERVICE=market-data --build-arg MODULE=aqros_market_data \
#     --build-arg PORT=8002 -t aqros/market-data .
# (docker-compose.yml sets these args for every service automatically.)

FROM python:3.12-slim AS runtime

# uv provides fast, reproducible installs.
COPY --from=ghcr.io/astral-sh/uv:0.10 /uv /uvx /bin/

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    VIRTUAL_ENV=/app/.venv \
    PATH="/app/.venv/bin:$PATH"

ARG SERVICE
ARG MODULE
ARG PORT=8000
ENV MODULE=${MODULE} \
    AQROS_HOST=0.0.0.0 \
    AQROS_PORT=${PORT}

WORKDIR /app

# Copy the workspace root (pyproject.toml + uv.lock) plus only the shared lib
# and the target service (keeps the image small and builds cache-friendly).
# The root files are required because every service's `aqros-core = { workspace
# = true }` source is declared in the *root* pyproject.toml — `uv pip install`
# on a service directory alone cannot resolve a workspace source (it has no
# workspace to resolve it against), so this service uses `uv sync --package`
# against the real workspace instead.
COPY pyproject.toml uv.lock ./
COPY libs ./libs
COPY backend/${SERVICE} ./backend/${SERVICE}

# --frozen: install exactly what's pinned in uv.lock, never re-resolve.
# --no-dev: skip dev-only tooling (pytest, ruff, mypy, ...) in the runtime image.
# --package: install only this service (+ its workspace deps), not every
# service in the monorepo.
RUN uv sync --frozen --no-dev --package aqros-${SERVICE}

# Run as a non-root user.
RUN useradd --create-home --uid 1000 appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE ${PORT}

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["python", "-c", "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:'+os.environ['AQROS_PORT']+'/health/live')"]

CMD python -m ${MODULE}.main
