# syntax=docker/dockerfile:1
# Generic, parameterized image for any AQROS backend service.
# Build with, e.g.:
#   docker build -f docker/Dockerfile.service \
#     --build-arg SERVICE=market-data --build-arg MODULE=aqros_market_data \
#     --build-arg PORT=8002 -t aqros/market-data .
# (docker-compose.yml sets these args for every service automatically.)

# --- Supply chain ------------------------------------------------------------
# Both bases are pinned by digest, not tag. A tag like `python:3.12-slim` is
# mutable: whoever controls the registry can repoint it, which is how a supply
# chain compromise gets in. Digest pinning makes the build reproducible and the
# contents verifiable.
#
# Refresh a pin with:
#   docker buildx imagetools inspect python:3.12-slim  --format '{{.Manifest.Digest}}'
#   docker buildx imagetools inspect ghcr.io/astral-sh/uv:0.10 --format '{{.Manifest.Digest}}'
#
# Note: `--from=` cannot take an ARG, so each pinned image gets its own named
# stage that the runtime stage copies from. That is the workaround BuildKit
# requires, not an accident.
FROM ghcr.io/astral-sh/uv:0.10@sha256:72ab0aeb448090480ccabb99fb5f52b0dc3c71923bffb5e2e26517a1c27b7fec AS uv

FROM python:3.12-slim@sha256:02108f5d322dd89f1c9e552442c25acb0543dfdbc455693a5599624f20d9155d AS runtime

# uv provides fast, reproducible installs.
COPY --from=uv /uv /uvx /bin/

# libgomp1 (the GNU OpenMP runtime) is a hard shared-library dependency of
# LightGBM and XGBoost — the training-pipeline service imports both at module
# load time, and they fail with "libgomp.so.1: cannot open shared object file"
# on the slim base image without it. Installed unconditionally here (a few
# hundred KB) so the shared image works for every service; a harmless no-op
# for services that don't use those libraries.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    VIRTUAL_ENV=/app/.venv \
    PATH="/app/.venv/bin:$PATH"

ARG SERVICE
ARG MODULE
ARG PORT=8000
ENV MODULE=${MODULE} \
    AQROS_HOST=0.0.0.0 \
    AQROS_PORT=${PORT}

WORKDIR /app

# Copy the workspace root (pyproject.toml + uv.lock) plus only the shared lib
# and the target service (keeps the image small and builds cache-friendly).
# The root files are required because every service's `aqros-core = { workspace
# = true }` source is declared in the *root* pyproject.toml — `uv pip install`
# on a service directory alone cannot resolve a workspace source (it has no
# workspace to resolve it against), so this service uses `uv sync --package`
# against the real workspace instead.
COPY pyproject.toml uv.lock ./
COPY libs ./libs
COPY backend/${SERVICE} ./backend/${SERVICE}

# --frozen: install exactly what's pinned in uv.lock, never re-resolve.
# --no-dev: skip dev-only tooling (pytest, ruff, mypy, ...) in the runtime image.
# --package: install only this service (+ its workspace deps), not every
# service in the monorepo.
RUN uv sync --frozen --no-dev --package aqros-${SERVICE}

# Entrypoint, with the module name substituted at BUILD time.
#
# This exists because of a real bug: `CMD ["python", "-m", "${MODULE}.main"]`
# looks correct, but exec form has no shell, so ${MODULE} stays literal and the
# container crash-loops on ModuleNotFoundError. Shell form
# (`CMD python -m ${MODULE}.main`) expands correctly but makes python a child of
# /bin/sh, so SIGTERM never reaches uvicorn and an in-flight order is cut off
# rather than drained.
#
# Baking the value in here gets both: correct expansion, and `exec` so python is
# PID 1 and receives SIGTERM directly. This must run BEFORE `USER appuser`,
# because /usr/local/bin is root-owned. The `cat` makes the resolved command
# visible in the build log — a silently wrong module name is otherwise very
# hard to spot.
RUN echo '#!/bin/sh' > /usr/local/bin/entrypoint.sh \
    && echo "exec python -m ${MODULE}.main" >> /usr/local/bin/entrypoint.sh \
    && chmod +x /usr/local/bin/entrypoint.sh \
    && cat /usr/local/bin/entrypoint.sh

# Run as a non-root user. `/data` is pre-created here (not just `/app`)
# because services that mount a named volume for artifacts (e.g.
# dataset-builder's Parquet output, training-pipeline's and model-registry's
# model artifacts) need it owned by `appuser` up front — Docker only copies
# an image path's ownership into a *new* named volume the first time it's
# mounted, so this must exist with the right owner before any volume is
# attached at/under it. Harmless no-op for services that don't use it.
RUN useradd --create-home --uid 1000 appuser \
    && mkdir -p /data/dataset-builder/artifacts /data/training-pipeline/artifacts /data/model-registry/artifacts \
    && chown -R appuser:appuser /app /data
USER appuser

EXPOSE ${PORT}

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["python", "-c", "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:'+os.environ['AQROS_PORT']+'/health/live')"]

CMD ["/usr/local/bin/entrypoint.sh"]
